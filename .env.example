# ═══════════════════════════════════════════════════
#  MontoCRM — 环境变量模板（复制为 .env 并填写真实值）
# ═══════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────
APP_ENV=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://localhost,https://localhost:18443
RATE_LIMIT_ENABLED=true
# 开发保持宽松；生产改为 5 / 10（与 Nginx limit_req 一致）
RATE_LIMIT_AUTH_PER_MIN=120
RATE_LIMIT_EXTRACT_PER_MIN=120
# 宿主端口；443 被 IIS/Apache 占用时改为 18443（HTTP 301 会带上该端口）
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Windows 上 80/443 常被 IIS/Apache 占用。443 被占时改为 18443（HTTP 301 会带上该端口）
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Database ─────────────────────────────────────────
POSTGRES_USER=montocrm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=montocrm
DATABASE_URL=postgresql+asyncpg://montocrm:changeme@postgres:5432/montocrm

# ── Redis / Celery ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── LLM Provider 白名单 ────────────────────────────────
# Admin UI 仅能选择此列表内的 Provider
LLM_AVAILABLE_PROVIDERS=dashscope,deepseek,openai,mock

# 全局默认（可被 Admin DB 设置覆盖）
LLM_DEFAULT_PROVIDER=dashscope
LLM_DEFAULT_MODEL=qwen3.7-flash-2026-07-15

# 主挂时自动降级
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-v4-flash

# ── 按 Agent 默认（可被 Admin DB 覆盖）────────────────
LLM_PLANNER_PROVIDER=dashscope
LLM_PLANNER_MODEL=qwen3.7-flash-2026-07-15
LLM_SYNTH_PROVIDER=dashscope
LLM_SYNTH_MODEL=qwen3.7-flash-2026-07-15
LLM_CUSTOMER_INSIGHT_PROVIDER=dashscope
LLM_CUSTOMER_INSIGHT_MODEL=qwen3.7-flash-2026-07-15
LLM_OPPORTUNITY_JUDGE_PROVIDER=dashscope
LLM_OPPORTUNITY_JUDGE_MODEL=qwen3.7-flash-2026-07-15
LLM_RISK_SENTINEL_PROVIDER=dashscope
LLM_RISK_SENTINEL_MODEL=qwen3.7-flash-2026-07-15
LLM_ACTION_PLANNER_PROVIDER=dashscope
LLM_ACTION_PLANNER_MODEL=qwen3.7-flash-2026-07-15

# ── Provider API Keys（never 暴露给前端）────────────────
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Embedding / Rerank（RAG 专用，torch 不进 API）────────
# local = hash 向量 + lexical rerank（Docker/CI）
# sidecar = 本机 HF 服务 apps/hf-sidecar（BGE-M3 1024 维 + reranker-v2-m3）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANK_ENABLED=true
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=20
RERANK_RETURN_N=5
HF_SIDECAR_URL=http://127.0.0.1:18090
HF_SIDECAR_TIMEOUT_SEC=60
# 启动 sidecar 后改为：
# EMBEDDING_PROVIDER=sidecar
# RERANK_PROVIDER=sidecar
# 然后：alembic upgrade head && python scripts/reindex.py --full
RAG_RRF_K=60
RAG_VECTOR_WEIGHT=1.0
RAG_KEYWORD_WEIGHT=1.0
RAG_REWRITE_TIMEOUT_SEC=3.0
RAG_EXPAND_ENABLED=false

# ── LLM Guard ─────────────────────────────────────────
GUARD_ENABLED=true
GUARD_MODE=hybrid
GUARD_SENSITIVITY=0.85
GUARD_MAX_INPUT_CHARS=10000
GUARD_MAX_OUTPUT_CHARS=8000
# GUARD_API_URL=http://llm-guard:8001

# ── Langfuse（留空则 Mock exporter，CI 不红）────────────
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# heuristic = 无 LLM 可跑；llm = 需安装 ragas 并配 Key
RAGAS_BACKEND=heuristic

# ── 钉钉群自定义机器人（P8）────────────────────────────
# 群设置 → 智能群助手 → 添加机器人 → 自定义
# 安全设置必须选「加签」，把 Secret 填到 DINGTALK_SECRET（无 Secret 拒绝发送）
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
DINGTALK_QUIET_START=22:00
DINGTALK_QUIET_END=08:00
DINGTALK_TZ=Asia/Shanghai
APP_PUBLIC_BASE_URL=http://localhost:3000

# ── 套配置示例 ─────────────────────────────────────────
# 套 A（当前默认）：千问主 + DeepSeek 备
# LLM_DEFAULT_PROVIDER=dashscope
# LLM_DEFAULT_MODEL=qwen3.7-flash-2026-07-15
# LLM_FALLBACK_PROVIDER=deepseek
# LLM_FALLBACK_MODEL=deepseek-v4-flash
# DASHSCOPE_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# 套 B：OpenAI 主 + DeepSeek 备（海外部署）
# LLM_DEFAULT_PROVIDER=openai
# LLM_DEFAULT_MODEL=gpt-4o
# LLM_FALLBACK_PROVIDER=deepseek
# LLM_FALLBACK_MODEL=deepseek-v4-flash
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
